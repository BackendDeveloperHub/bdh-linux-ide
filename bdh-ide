#!/bin/bash
# BDH IDE — Final merged launcher (ranger + nano + terminal, tmux based)

SESSION="archide"
CONFIG_DIR="/etc/bdh-ide"
WRAPPER="/tmp/bdh-nano-wrapper.sh"

# =========================================================
# ⚙️ CUSTOM WINDOW SIZES
# =========================================================
NANO_WIDTH=70        # Nano takes 70% space on the right
TERMINAL_HEIGHT=40   # Terminal takes 40% space on the bottom left
# =========================================================

# Unset TMUX to avoid nesting errors
unset TMUX

# --- Kill existing session if it's already running ---
if tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux kill-session -t "$SESSION"
fi

# =========================================================
# 🚀 CREATE PANES AND CAPTURE THEIR UNIQUE IDs
# =========================================================

# 1. Create Session (This becomes Ranger pane)
tmux -f "$CONFIG_DIR/tmux.conf" new-session -d -s "$SESSION" -n "BDH-IDE"
PANE_RANGER=$(tmux display-message -p -t "$SESSION" '#{pane_id}')

# 2. Split right for Nano and capture its ID
PANE_NANO=$(tmux split-window -h -p "$NANO_WIDTH" -t "$PANE_RANGER" -P -F "#{pane_id}")

# 3. Split bottom-left for Terminal and capture its ID
PANE_TERM=$(tmux split-window -v -p "$TERMINAL_HEIGHT" -t "$PANE_RANGER" -P -F "#{pane_id}")

# =========================================================
# 📜 DYNAMIC WRAPPER SCRIPT (Using Bulletproof Respawn Logic)
# =========================================================
cat <<EOF > "$WRAPPER"
#!/bin/bash
[ "\$1" == "--" ] && shift

FILE_PATH="\$1"
DIR_PATH=\$(dirname "\$FILE_PATH")
FILE_NAME=\$(basename "\$FILE_PATH")

# 1. Force-kill whatever is running in Nano pane, fresh shell start
tmux respawn-pane -k -t "$PANE_NANO"
sleep 0.1
tmux send-keys -t "$PANE_NANO" "cd \"\$DIR_PATH\" && clear && nano \"\$FILE_NAME\"" C-m

# 2. Terminal Pane path sync
tmux send-keys -t "$PANE_TERM" C-c
sleep 0.1
tmux send-keys -t "$PANE_TERM" "cd \"\$DIR_PATH\" && clear && ls" C-m

# 3. Focus Nano
tmux select-pane -t "$PANE_NANO"
EOF
chmod +x "$WRAPPER"

# =========================================================
# 🎬 START THE PROGRAMS IN THEIR EXACT PANES
# =========================================================

# 1. Start Ranger (Top Left)
tmux send-keys -t "$PANE_RANGER" \
    "export DISPLAY=''; export WAYLAND_DISPLAY=''; export EDITOR=$WRAPPER; clear; ranger --cmd='set preview_files false'" C-m

# 2. Nano Welcome Screen (Right)
tmux send-keys -t "$PANE_NANO" \
    "clear; echo -e '\n  \e[1;32mWelcome to BDH IDE!\e[0m\n  Press \e[1;33mEnter\e[0m on a file in Ranger to open it here.\n  The Terminal on the left will \e[1;36mauto-sync the directory path!\e[0m\n'" C-m

# 3. Focus Terminal (Bottom Left)
tmux select-pane -t "$PANE_TERM"

tmux attach -t "$SESSION"

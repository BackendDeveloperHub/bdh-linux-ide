#!/bin/bash
# =========================================================
# 🚀 BDH LINUX IDE — SMART INSTALLER (v1.0)
# =========================================================

echo -e "\e[1;36m+===================================================+\e[0m"
echo -e "\e[1;32m       🔥 INSTALLING BDH LINUX IDE (v1.0) 🔥       \e[0m"
echo -e "\e[1;36m+===================================================+\e[0m"

# 1. Detect Environment (Termux vs Arch Linux)
if [ -n "$PREFIX" ] && [ -d "$PREFIX/bin" ]; then
    IS_TERMUX=true
    BIN_PATH="$PREFIX/bin"
    echo -e "\n\e[1;33m[1/3] Termux Environment Detected. Installing dependencies...\e[0m"
    pkg update -y
    pkg install -y clang make postgresql git
else
    IS_TERMUX=false
    BIN_PATH="/usr/local/bin"
    echo -e "\n\e[1;33m[1/3] Arch Linux Detected. Installing dependencies...\e[0m"
    sudo pacman -S --needed --noconfirm base-devel git postgresql gcc make
fi

# 2. Compile the Modular C Engine via Makefile
echo -e "\n\e[1;33m[2/3] Compiling BDH-IDE Modular Engine...\e[0m"
make clean && make

if [ ! -f "bin/bdh-linux-ide" ]; then
    echo -e "\e[1;31m❌ Compilation failed! Please check the C files and Makefile.\e[0m"
    exit 1
fi

# 3. Install Binary to System Path
echo -e "\n\e[1;33m[3/3] Installing Binary to $BIN_PATH...\e[0m"
if [ "$IS_TERMUX" = true ]; then
    cp bin/bdh-linux-ide $BIN_PATH/bdh-ide
    chmod +x $BIN_PATH/bdh-ide
else
    sudo cp bin/bdh-linux-ide $BIN_PATH/bdh-ide
    sudo chmod +x $BIN_PATH/bdh-ide
fi

echo -e "\n\e[1;32m✅ BDH IDE Setup Completed Successfully!\e[0m"
echo -e "\e[1;36m   Run 'bdh-ide' in your terminal to launch! 🚀\e[0m"

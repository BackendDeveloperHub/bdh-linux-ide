#!/bin/bash
# BDH IDE — Zero-Tmux Sovereign Launcher
# Powered exclusively by bdh-terminal-engine (Pure POSIX C)

# =========================================================
# 1. 🌍 ENVIRONMENT & WORKSPACE SETUP
# =========================================================
export BDH_IDE_ACTIVE=1
export EDITOR="nano"
export BROWSER="bdh-browser"
export PATH="/usr/local/bin:$PATH"

# ப்ராஜெக்ட் டைரக்டரியை செட் செய்கிறோம் (தற்போதுள்ள ஃபோல்டர்)
PROJECT_DIR="$PWD"

# =========================================================
# 2. 🖥️ STARTUP WELCOME BANNER
# =========================================================
clear
echo -e "\e[1;36m+===================================================+\e[0m"
echo -e "\e[1;32m       🚀 BDH LINUX IDE — SOVEREIGN EDITION        \e[0m"
echo -e "\e[1;36m+===================================================+\e[0m"
echo -e "  Engine    : \e[1;33mbdh-terminal-engine (Zero-Tmux / Pure C)\e[0m"
echo -e "  Workspace : \e[1;35m$PROJECT_DIR\e[0m"
echo -e "  Tabs      : \e[1;36m[1:CODE] [2:FILES] [3:SERVER] [4:BROWSER]\e[0m"
echo -e "\e[1;36m+===================================================+\e[0m"
echo -e "\e[0;37m  Starting Native Terminal Engine in 0.5s...\e[0m"
sleep 0.5

# =========================================================
# 3. 🔥 LAUNCH SOVEREIGN C MULTIPLEXER
# =========================================================
# tmux-க்கு பதிலாக நமது சொந்த C இன்ஜினை மெயின் ப்ராசஸாக (exec) ஓட்டுகிறோம்.
# (டீஃபால்ட் டேப்களான nano, ranger, server அனைத்தும் இன்ஜினுக்குள்ளேயே தொடங்கும்)
cd "$PROJECT_DIR" && exec bdh-terminal-engine "$@"

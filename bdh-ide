#!/bin/bash
# BDH IDE — Final merged launcher (ranger + nano + terminal, tmux based)

SESSION="archide"
CONFIG_DIR="/etc/bdh-ide"

# =========================================================
# ⚙️ CUSTOM WINDOW SIZES
# =========================================================
NANO_WIDTH=70        # Nano takes 70% space on the right
TERMINAL_HEIGHT=40   # Terminal takes 40% space on the bottom left
# =========================================================

WRAPPER="/tmp/bdh-nano-wrapper.sh"

# Unset TMUX to avoid nesting errors if already inside a tmux session
unset TMUX

# --- Generate wrapper script (created fresh on every run) ---
cat <<EOF > "$WRAPPER"
#!/bin/bash
[ "\$1" == "--" ] && shift

FILE_PATH="\$1"
DIR_PATH=\$(dirname "\$FILE_PATH")

# 1. Open file in Nano pane (Pane 2 - Right side)
tmux send-keys -t 2 C-c
sleep 0.1
tmux send-keys -t 2 "nano \"\$FILE_PATH\"" C-m

# 2. Change directory in Terminal pane (Pane 1 - Bottom left)
tmux send-keys -t 1 C-c
sleep 0.1
tmux send-keys -t 1 "cd \"\$DIR_PATH\" && clear && ls" C-m

# 3. Switch cursor focus to Nano pane
tmux select-pane -t 2
EOF
chmod +x "$WRAPPER"

# --- Kill existing session if it's already running ---
if tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux kill-session -t "$SESSION"
fi

# --- Create new session + 3-pane layout ---
tmux -f "$CONFIG_DIR/tmux.conf" new-session -d -s "$SESSION" -n "BDH-IDE"

# 1. Split screen left/right (Right side Nano 70%)
tmux split-window -h -p "$NANO_WIDTH" -t "$SESSION"

# 2. Split left pane (Pane 0) top/bottom (Bottom Terminal 40%)
tmux select-pane -t "$SESSION:0.0"
tmux split-window -v -p "$TERMINAL_HEIGHT" -t "$SESSION:0.0"

# Current Pane Layout:
# 0 = Ranger (Top Left)
# 1 = Terminal (Bottom Left)
# 2 = Nano (Entire Right Side)

# 1. Ranger pane (Pane 0)
tmux select-pane -t "$SESSION:0.0"
tmux send-keys -t "$SESSION:0.0" \
    "export DISPLAY=''; export WAYLAND_DISPLAY=''; export EDITOR=$WRAPPER; clear; ranger" C-m

# 2. Nano welcome pane (Pane 2)
tmux select-pane -t "$SESSION:0.2"
tmux send-keys -t "$SESSION:0.2" \
    "clear; echo -e '\n  \e[1;32mWelcome to BDH IDE!\e[0m\n  Press \e[1;33mEnter\e[0m on a file in Ranger to open it here.\n  The Terminal on the left will \e[1;36mauto-sync the directory path!\e[0m\n'" C-m

# 3. Main terminal pane (Pane 1) - Leave cursor here
tmux select-pane -t "$SESSION:0.1"

tmux attach -t "$SESSION"
